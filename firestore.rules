rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User isolation: Users only access their own journal entries
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/journals/{journalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin dashboard isolation: Only elevated custom claims can read/write
    match /admin/{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
  }
}
